      "item": [
        {
          "name": "Login Admin",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "",
                  "if (pm.response.code === 200) {",
                  "  const body = pm.response.json();",
                  "  pm.collectionVariables.set('admin_token', body.access_token);",
                  "  pm.collectionVariables.set('admin_refresh_token', body.refresh_token);",
                  "  pm.test('Role admin', () => pm.expect(body.user.role).to.eql('admin'));",
                  "  pm.test('Access token 600 detik', () => pm.expect(body.expires_in).to.eql(600));",
                  "  pm.test('Refresh token 86400 detik', () => pm.expect(body.refresh_expires_in).to.eql(86400));",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "X-Device-ID",
                "value": "{{admin_device}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"{{admin_username}}\",\n  \"password\": \"{{admin_password}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{gateway_url}}/auth/login",
            "description": "Login admin. Token disimpan otomatis."
