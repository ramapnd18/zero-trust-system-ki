datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL") // "file:../database/zerotrust.db"
}

generator client {
  provider      = "prisma-client-js"
  // "native" untuk pengembangan lokal, target Debian untuk container node:22-bookworm-slim
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

model User {
  id            Int            @id @default(autoincrement())
  username      String         @unique
  password_hash String
  role          String         // 'mahasiswa', 'dosen', 'admin'
  devices       Device[]
  refreshTokens RefreshToken[]
  kelasAmpu     Kelas[]        @relation("DosenKelas")
  nilai         Nilai[]
  transkrip     Transkrip?
}

model Device {
  id        Int    @id @default(autoincrement())
  device_id String // Menyimpan X-Device-ID
  user      User   @relation(fields: [userId], references: [id])
  userId    Int
}

model RefreshToken {
  id         Int      @id @default(autoincrement())
  token      String   @unique
  expires_at DateTime
  user       User     @relation(fields: [userId], references: [id])
  userId     Int
}

model Kelas {
  id               Int     @id @default(autoincrement())
  nama_mata_kuliah String
  dosen            User    @relation("DosenKelas", fields: [dosenId], references: [id])
  dosenId          Int
  nilai            Nilai[]
}

model Nilai {
  id           Int     @id @default(autoincrement())
  skor         Float
  status       String  // 'draft' atau 'final'
  kelas        Kelas   @relation(fields: [kelasId], references: [id])
  kelasId      Int
  mahasiswa    User    @relation(fields: [mahasiswaId], references: [id])
  mahasiswaId  Int
}

model Transkrip {
  id          Int    @id @default(autoincrement())
  data_nilai  String // JSON string / text
  mahasiswa   User   @relation(fields: [mahasiswaId], references: [id])
  mahasiswaId Int    @unique
}

model AuditLog {
  id        Int      @id @default(autoincrement())
  waktu     DateTime @default(now())
  subjek    String
  endpoint  String
  device    String?
  keputusan String   // 'allow' atau 'deny'
  alasan    String
}
