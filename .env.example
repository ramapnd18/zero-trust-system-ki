# ============================================================
# Sistem Nilai Zero Trust - template environment
# Salin file ini menjadi .env lalu ganti semua nilai CHANGE_ME.
# JANGAN pernah commit file .env.
# ============================================================

NODE_ENV=development
TZ=Asia/Jakarta

# --- Database ---
# Path relatif terhadap prisma/schema.prisma.
# Di Docker, docker-compose.yml meng-override menjadi file:/app/database/zerotrust.db
DATABASE_URL="file:../database/zerotrust.db"

# --- JWT (access 10 menit, refresh 1 hari, service 5 menit) ---
JWT_SECRET=CHANGE_ME_JWT_SECRET
JWT_ISSUER=zero-trust-gateway
JWT_AUDIENCE=zero-trust-services
ACCESS_TOKEN_TTL=10m
REFRESH_TOKEN_TTL=1d
SERVICE_TOKEN_TTL=5m

# --- Gateway secret (wajib disisipkan gateway ke setiap request downstream) ---
GATEWAY_SECRET=CHANGE_ME_GATEWAY_SECRET

# --- Kredensial service internal (hanya service-nilai) ---
SERVICE_CLIENT_ID=service-nilai
SERVICE_CLIENT_SECRET=CHANGE_ME_SERVICE_CLIENT_SECRET

# --- Jam operasional perubahan & finalisasi nilai (waktu lokal TZ) ---
OPERATIONAL_START_HOUR=7
OPERATIONAL_END_HOUR=21

# --- Seeding awal (demo). Set false setelah data production ada. ---
SEED_ON_START=true
SEED_ADMIN_PASSWORD="Admin#2026"
SEED_DOSEN_PASSWORD="Dosen#2026"
SEED_MAHASISWA_PASSWORD="Mhs#2026"

# --- URL internal ---
# docker-compose.yml sudah menetapkan nilai untuk container.
# Untuk menjalankan service langsung di host, gunakan variasi localhost:
# SERVICE_NILAI_URL=http://127.0.0.1:3001
# SERVICE_TRANSKRIP_URL=http://127.0.0.1:3002
# GATEWAY_INTERNAL_URL=http://127.0.0.1:3000
